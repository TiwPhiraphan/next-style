{
	"name": "next-style",
	"version": "2.0.0",
	"description": "Zero-Runtime CSS-in-JS for Next.js + Turbopack",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./plugin": {
			"import": "./dist/postcss-plugin/index.js",
			"types": "./dist/postcss-plugin/index.d.ts"
		}
	},
	"files": ["dist"],
	"scripts": {
		"export": "bun run build:ts && bun run build:types",
		"build:ts": "tsc",
		"build:types": "tsc --emitDeclarationOnly",
		"dev": "tsc --watch",
		"test": "bun test",
		"lint": "biome lint",
		"format": "biome format --write"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.7.0",
		"csstype": "^3.2.3",
		"postcss": "^8.5.14",
		"typescript": "^5"
	},
	"peerDependencies": {
		"postcss": "^8.4.31"
	},
	"keywords": ["css-in-js", "zero-runtime", "next.js", "turbopack", "postcss", "style", "next-style", "css"],
	"author": "TiwPhiraphan",
	"license": "MIT"
}
