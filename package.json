{
	"name": "next-style",
	"version": "2.0.1",
	"description": "Zero-Runtime CSS-in-JS for Next.js + Turbopack",
	"type": "module",
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TiwPhiraphan/next-style.git"
	},
	"bugs": {
		"url": "https://github.com/TiwPhiraphan/next-style/issues"
	},
	"homepage": "https://github.com/TiwPhiraphan/next-style#readme",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./plugin": {
			"types": "./dist/postcss-plugin/index.d.ts",
			"import": "./dist/postcss-plugin/index.mjs",
			"require": "./dist/postcss-plugin/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"export": "tsup",
		"build:watch": "tsup --watch",
		"dev": "tsup --watch",
		"test": "bun test",
		"lint": "biome lint",
		"format": "biome format --write"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/node": "^25.7.0",
		"@types/bun": "^1.3.14",
		"csstype": "^3.2.3",
		"tsup": "^8.5.1",
		"typescript": "^5"
	},
	"peerDependencies": {
		"postcss": ">=8.4.31"
	},
	"keywords": [
		"css-in-js",
		"zero-runtime",
		"next.js",
		"turbopack",
		"postcss",
		"style",
		"next-style",
		"css"
	],
	"author": "TiwPhiraphan",
	"license": "MIT"
}
